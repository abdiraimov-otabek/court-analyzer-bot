TELEGRAM_BOT_TOKEN=
KAD_API_BASE_URL=https://kad.arbitr.ru/
KAD_API_KEY=

# Admin API auth (Bearer token)
ADMIN_AUTH_TOKEN=
HASH_SALT=

# SQLite DB path
DATABASE_PATH=data/app.db

# Source selection (kad or sudact - sudact is deprecated)
DECISION_SOURCE_MODE=kad

# OpenRouter API key for LLM reason extraction fallback (Optional)
OPENROUTER_API_KEY=

# CAPTCHA solving service (Optional - enables auto-solving for blocked PDFs)
# Supports 2Captcha-compatible APIs
CAPTCHA_SOLVER_API_KEY=
CAPTCHA_SOLVER_URL=https://2captcha.com
CAPTCHA_SOLVER_TIMEOUT=180

# Settings
SHADOW_MODE_ENABLED=false
